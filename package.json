{
  "name": "cvforge",
  "version": "1.1.0",
  "description": "Write your CV as data, get a beautiful, ATS-friendly PDF. Eight premium themes, JSON Resume compatible, auto-fit to one page, live studio and web app. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Iradukunda Bertin (https://bertin.vercel.app)",
  "homepage": "https://cvdesign.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bertini01/cv-builder.git"
  },
  "bugs": "https://github.com/bertini01/cv-builder/issues",
  "keywords": [
    "cv",
    "resume",
    "pdf",
    "json-resume",
    "resume-builder",
    "cv-generator",
    "ats",
    "themes",
    "cli"
  ],
  "bin": {
    "cvforge": "bin/cvforge.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "examples/resume.json",
    "examples/avatar.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node bin/cvforge.mjs build examples/resume.json",
    "studio": "node bin/cvforge.mjs studio examples/resume.json",
    "previews": "node scripts/previews.mjs",
    "web": "node scripts/build-web.mjs",
    "test": "node --test \"test/*.test.mjs\""
  }
}
